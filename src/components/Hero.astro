</div>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 76px;
    padding-bottom: 76px;
    overflow: hidden;
  }

  /* Column rules — the layout grid made faintly visible. Structure, not
     texture: it marks the same 12 columns the content is set on. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      rgba(20, 20, 20, 0.045) 0 1px,
      transparent 1px calc(100% / 12)
    );
    background-position: var(--gutter) 0;
    background-size: calc(100% - var(--gutter) * 2) 100%;
    background-repeat: no-repeat;
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    pointer-events: none;
    z-index: 0;
  }

  .hero > .container {
    position: relative;
    z-index: 1;
  }

  .hero-wrapper {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(20px, 3.5vw, 56px);
    text-align: left;
    position: relative;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    min-width: 0;
    /* The surname is allowed to run past this column so the portrait's
       shoulder can still cross it — the graze is the whole point. */
    overflow: visible;
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--c3-ink-soft);
  }

  .eyebrow-role {
    padding-left: 18px;
    border-left: 1px solid var(--c3-line);
  }

  .eyebrow-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--c3-green-text);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--c3-green-deep);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .badge-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--c3-green-deep);
    opacity: 0.35;
    animation: pulse-ring 2.5s ease-in-out infinite;
  }

  @keyframes pulse-ring {
    0%, 100% { transform: scale(1); opacity: 0.35; }
    50% { transform: scale(2); opacity: 0; }
  }

  /* Composition — name and portrait occupy one grid cell so the cutout's
     alpha does the occluding. Bottom-aligned: the shoulders land on the
     surname, the head rises clear above the first line. */
  .hero-name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Sized to nearly fill its column, so the name block and the portrait
       carry the same optical mass. Both scale with vw (see .hero-portrait)
       so the gap between them stays proportionate instead of drifting. */
    font-size: clamp(2.4rem, 7.6vw, 8rem);
    color: var(--c3-ink);
    position: relative;
    z-index: 1;
  }

  .name-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    white-space: nowrap;
  }

  .name-letter {
    display: inline-block;
  }

  /* Portrait — its own column, sized against viewport *width* so it tracks the
     name (which is also vw-driven) and the gap between them stays constant
     rather than drifting as the two scale on different axes. `max-height`
     keeps it inside short viewports; `aspect-ratio` shrinks the width to
     match when it does. */
  .hero-portrait {
    position: relative;
    width: clamp(230px, 34vw, 520px);
    max-height: 68vh;
    aspect-ratio: 1086 / 1233;
    z-index: 2;
    pointer-events: none;
  }

  /* Grounding wash — without it the cutout floats on bare white. Sits behind
     the figure, tinted with the signature accent. */
  .hero-portrait::before {
    content: '';
    position: absolute;
    inset: 6% -18% -4% -18%;
    background: radial-gradient(
      58% 52% at 50% 52%,
      rgba(15, 243, 120, 0.26),
      rgba(15, 243, 120, 0) 72%
    );
    z-index: -1;
  }

  /* The WebGL canvas replaces the <img> only once it has drawn a frame, so
     there is never a gap where neither is showing. */
  .hero-portrait :global(.hero-portrait-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-portrait.is-gl img {
    visibility: hidden;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    /* The pas foto crops the subject on three sides — mid-torso at the bottom
       and through the shoulders at both edges — so the cutout carries three
       hard cuts. Two intersecting gradients dissolve all of them: the figure
       fades into the page instead of ending on straight lines. The horizontal
       pass is safe because the head never reaches the frame edges. */
    mask-image:
      linear-gradient(to bottom, #000 74%, transparent 99%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to bottom, #000 74%, transparent 99%),
      linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-composite: source-in;
  }

  /* Bottom: description + CTAs */
  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    max-width: 46ch;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* CTAs — MetaMask pill language */
  .hero-cta {
    display: flex;
    gap: 14px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--c3-green);
    color: var(--c3-dark);
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s var(--ease-out-expo);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(15, 243, 120, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--c3-surface);
    color: var(--c3-ink);
    padding: 16px 32px;
    border-radius: 12px;
    border: 1px solid var(--c3-line);
    font-weight: 600;
    font-size: 0.95rem;
    transition: border-color 0.3s var(--ease-out-expo), background 0.3s var(--ease-out-expo);
    cursor: pointer;
    font-family: var(--font-main);
  }

  .btn-secondary:hover {
    border-color: var(--c3-ink);
    background: var(--c3-surface-2);
  }

  /* Ledger — three facts on a hairline rule. Figures carry the weight; the
     labels stay quiet in mono. Replaces the boxed stat cards. */
  .hero-ledger {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--c3-line);
    padding-top: 20px;
    margin: 0;
    width: 100%;
    max-width: 640px;
  }

  .ledger-entry {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-inline: 28px;
    border-left: 1px solid var(--c3-line);
    flex: 1 1 0;
    min-width: 0;
  }

  .ledger-entry:first-child {
    padding-left: 0;
    border-left: none;
  }

  .ledger-figure {
    font-size: 2rem;
    font-weight: 600;
    color: var(--c3-ink);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .ledger-unit {
    color: var(--c3-green-text);
  }

  .ledger-label {
    color: var(--text-secondary);
    margin: 0;
  }

  /* Tablet & Mobile — Center aligned layout */
  @media (max-width: 968px) {
    .hero-wrapper {
      align-items: center;
      text-align: center;
    }

    .hero-eyebrow {
      justify-content: center;
    }

    /* One column. The portrait leads — putting it after the text would strand
       it below the ledger, far from the name it belongs to. */
    .hero-wrapper {
      grid-template-columns: 1fr;
      row-gap: 26px;
    }

    .hero-text {
      align-items: center;
      text-align: center;
    }

    .hero-name {
      align-items: center;
      text-align: center;
      font-size: clamp(2.4rem, 9vw, 4.4rem);
    }

    .hero-portrait {
      order: -1;
      justify-self: center;
      width: clamp(190px, 52vw, 300px);
      max-height: 40vh;
    }

    .hero-bottom {
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .hero-description {
      text-align: center;
      margin-inline: auto;
    }

    .hero-cta {
      justify-content: center;
      width: 100%;
    }

    .hero-ledger {
      justify-content: center;
      margin-inline: auto;
    }
  }

  @media (max-width: 768px) {
    .hero-text { gap: 24px; }

    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 10px 14px;
      justify-content: center;
    }

    .hero-cta {
      flex-direction: column;
      width: 100%;
      max-width: 380px;
      margin-inline: auto;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .hero-ledger {
      padding-top: 16px;
    }

    .ledger-entry {
      padding-inline: 12px;
      text-align: center;
    }

    .ledger-figure { font-size: 1.5rem; }
    .ledger-label { font-size: 0.62rem; letter-spacing: 0.1em; }
  }
</style>

<style is:global>
  /* Contact modal — light card (MetaMask style) */
  #contact-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(1, 30, 28, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  #contact-modal.active {
    opacity: 1;
    visibility: visible;
  }

  #contact-modal .modal-content {
    background: var(--mm-white);
    border-radius: clamp(20px, 4vw, 28px);
    padding: clamp(24px, 5vw, 40px);
    max-width: 500px;
    width: 100%;
    position: relative;
    transform: translateY(30px) scale(0.95);
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 25px 80px -12px rgba(0, 0, 0, 0.6);
  }

  #contact-modal.active .modal-content {
    transform: translateY(0) scale(1);
  }

  #contact-modal .modal-close {
    position: absolute;
    top: clamp(12px, 3vw, 20px);
    right: clamp(12px, 3vw, 20px);
    background: rgba(10, 10, 10, 0.05);
    border: 1px solid rgba(10, 10, 10, 0.12);
    color: rgba(10, 10, 10, 0.65);
    width: clamp(36px, 8vw, 44px);
    height: clamp(36px, 8vw, 44px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  #contact-modal .modal-close:hover {
    background: var(--mm-black);
    color: var(--mm-white);
    transform: rotate(90deg);
  }

  #contact-modal .modal-header {
    text-align: center;
    margin-bottom: clamp(24px, 6vw, 36px);
    padding: 0 20px;
  }

  #contact-modal .modal-title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 5vw, 1.8rem);
    color: var(--mm-black);
    margin-bottom: 8px;
  }

  #contact-modal .modal-subtitle {
    color: rgba(10, 10, 10, 0.55);
    font-size: clamp(0.85rem, 2.5vw, 1rem);
    line-height: 1.4;
  }

  #contact-modal .contact-list {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vw, 14px);
  }

  #contact-modal .contact-item {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 18px);
    padding: clamp(14px, 3vw, 20px);
    background: rgba(10, 10, 10, 0.03);
    border: 1.5px solid rgba(10, 10, 10, 0.1);
    border-radius: clamp(14px, 3vw, 18px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  #contact-modal .contact-item:hover {
    border-color: var(--mm-black);
    background: rgba(10, 10, 10, 0.05);
    transform: translateX(4px);
  }

  #contact-modal .contact-icon {
    width: clamp(40px, 10vw, 52px);
    height: clamp(40px, 10vw, 52px);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #contact-modal .email-icon { background: linear-gradient(135deg, #ea4335 0%, #fbbc05 100%); color: white; }
  #contact-modal .whatsapp-icon { background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); color: white; }
  #contact-modal .linkedin-icon { background: linear-gradient(135deg, #0077b5 0%, #00a0dc 100%); color: white; }

  #contact-modal .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  #contact-modal .contact-label {
    font-size: clamp(0.7rem, 2vw, 0.75rem);
    color: rgba(10, 10, 10, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  #contact-modal .contact-value {
    font-size: clamp(0.85rem, 2.8vw, 1rem);
    color: var(--mm-black);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }

  #contact-modal .contact-item:hover .contact-value {
    color: var(--mm-orange);
  }

  #contact-modal .contact-arrow {
    color: rgba(10, 10, 10, 0.3);
    transform: translateX(0);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  #contact-modal .contact-item:hover .contact-arrow {
    transform: translateX(4px);
    color: var(--mm-orange);
  }

  @media (max-width: 400px) {
    #contact-modal .modal-content { padding: 24px 16px; }
    #contact-modal .contact-item { padding: 12px; gap: 12px; }
    #contact-modal .contact-icon { width: 38px; height: 38px; }
    #contact-modal .contact-value { font-size: 0.8rem; }
  }
</style>

<script>
  import { trapFocus } from '../scripts/focus-trap';

  const openBtn = document.getElementById('open-contact-modal');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('contact-modal');
  const modalContent = modal?.querySelector<HTMLElement>('.modal-content');

  let releaseFocus: (() => void) | null = null;

  function openModal() {
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      if (modalContent) releaseFocus = trapFocus(modalContent);
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      releaseFocus?.();
      releaseFocus = null;
    }
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // The contact CTA section reuses this modal.
  document.querySelectorAll('[data-open-contact]').forEach((el) => {
    el.addEventListener('click', openModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      closeModal();
    }
  });
</script>
