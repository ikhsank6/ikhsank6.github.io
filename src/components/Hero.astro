<style>
  .hero {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 0 80px 0;
  }

  .hero-wrapper {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 10px 24px;
    border-radius: 100px;
    margin-bottom: 32px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .badge-dot {
    width: 10px;
    height: 10px;
    background: var(--accent-lime);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212, 255, 0, 0.4); }
    50% { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(212, 255, 0, 0); }
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    margin-bottom: 32px;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .text-muted {
    color: var(--text-secondary);
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 48px;
  }

  .accent-text {
    color: var(--accent-lime);
    font-weight: 600;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 40px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 24px 48px;
    border-radius: 24px;
    margin-bottom: 48px;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.5);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-value {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stat-divider {
    width: 1px;
    height: 48px;
    background: var(--border-subtle);
  }

  .hero-cta {
    display: flex;
    gap: 20px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: var(--accent-lime);
    color: #000;
    padding: 16px 32px;
    border-radius: 100px;
    font-weight: 700;
    font-size: 1rem;
    transition: var(--transition-smooth);
  }

  .btn-primary:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 15px 30px rgba(212, 255, 0, 0.3);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    color: var(--text-primary);
    padding: 16px 32px;
    border-radius: 100px;
    border: 1px solid var(--border-subtle);
    font-weight: 700;
    font-size: 1rem;
    transition: var(--transition-smooth);
  }

  .btn-secondary:hover {
    background: rgba(255,255,255,0.05);
    border-color: var(--text-primary);
    transform: translateY(-4px);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 80px 0;
    }
    
    .hero-stats {
      flex-direction: column;
      gap: 32px;
      padding: 32px;
      width: 100%;
    }

    .stat-divider {
      width: 60px;
      height: 1px;
    }

    .hero-cta {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<style is:global>
  /* Modal Styles - Global */
  #contact-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    padding: 20px;
  }

  #contact-modal.active {
    opacity: 1;
    visibility: visible;
  }

  #contact-modal .modal-content {
    background: linear-gradient(135deg, rgba(30, 30, 35, 0.98) 0%, rgba(15, 15, 20, 0.99) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 40px;
    max-width: 480px;
    width: 100%;
    position: relative;
    transform: translateY(30px) scale(0.9);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 
      0 25px 80px -12px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(255, 255, 255, 0.05) inset;
  }

  #contact-modal.active .modal-content {
    transform: translateY(0) scale(1);
  }

  #contact-modal .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #contact-modal .modal-close:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transform: rotate(90deg);
  }

  #contact-modal .modal-header {
    text-align: center;
    margin-bottom: 32px;
  }

  #contact-modal .modal-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  #contact-modal .modal-subtitle {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.95rem;
  }

  #contact-modal .contact-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #contact-modal .contact-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
  }

  #contact-modal .contact-item:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #d4ff00;
    transform: translateX(4px);
  }

  #contact-modal .contact-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #contact-modal .email-icon {
    background: linear-gradient(135deg, #ea4335 0%, #fbbc05 100%);
    color: white;
  }

  #contact-modal .whatsapp-icon {
    background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
    color: white;
  }

  #contact-modal .linkedin-icon {
    background: linear-gradient(135deg, #0077b5 0%, #00a0dc 100%);
    color: white;
  }

  #contact-modal .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  #contact-modal .contact-label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  #contact-modal .contact-value {
    font-size: 1rem;
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #contact-modal .contact-arrow {
    color: rgba(255, 255, 255, 0.3);
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  #contact-modal .contact-item:hover .contact-arrow {
    opacity: 1;
    transform: translateX(0);
    color: #d4ff00;
  }

  @media (max-width: 500px) {
    #contact-modal .modal-content {
      padding: 24px;
    }

    #contact-modal .contact-icon {
      width: 40px;
      height: 40px;
    }

    #contact-modal .contact-value {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  const openBtn = document.getElementById('open-contact-modal');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('contact-modal');

  function openModal() {
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  if (openBtn) {
    openBtn.addEventListener('click', openModal);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      closeModal();
    }
  });
</script>

