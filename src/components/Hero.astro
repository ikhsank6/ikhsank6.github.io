---
const firstName = 'Ikhsan';
const lastName = 'Kurniawan';

/* The hero ledger — three facts, set as data rather than prose. */
const ledger = [
  { figure: '05', unit: '+', label: 'Years building' },
  { figure: '10', unit: '+', label: 'Platforms shipped' },
  { figure: 'KUDUS', unit: '', label: 'Jawa Tengah, Indonesia' },
];
---

<section id="home" class="hero">
  <div class="container">
    <!-- Two columns of equal optical weight: the whole text stack on the left,
         the portrait standing full-height on the right, both centred on the
         same axis. The portrait still crosses the surname's last glyph — one
         small negative margin — so the two columns read as one composition
         rather than two panels side by side. -->
    <div class="hero-wrapper" data-hero-exit>

      <div class="hero-text">
        <p class="hero-eyebrow meta-type" data-hero="eyebrow">
          <span class="eyebrow-status">
            <span class="badge-dot"></span>
            Open to work
          </span>
          <span class="eyebrow-role">Fullstack Developer</span>
        </p>

        <h1 class="hero-name display-type" aria-label={`${firstName} ${lastName}`}>
          <span class="name-line" aria-hidden="true">
            {firstName.split('').map((letter) => <span class="name-letter">{letter}</span>)}
          </span>
          <span class="name-line" aria-hidden="true">
            {lastName.split('').map((letter) => <span class="name-letter">{letter}</span>)}
          </span>
        </h1>

      <div class="hero-bottom" data-hero="bottom">
        <p class="hero-description">
          I build reliable and scalable software solutions by designing backend services, frontend applications, and database architectures with Laravel, Node.js, Vue, and Next.js.
        </p>
        <div class="hero-cta">
          <a href="#projects" class="btn-primary" data-magnetic>
            View My Work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
          <button id="open-contact-modal" class="btn-secondary" data-magnetic>
            Let's Connect
          </button>
        </div>
      </div>

        <dl class="hero-ledger" data-hero="stats">
          {ledger.map((entry) => (
            <div class="ledger-entry">
              <dt class="ledger-figure">
                {entry.figure.length === 2
                  ? <span data-count={entry.figure}>{entry.figure}</span>
                  : entry.figure}<span class="ledger-unit">{entry.unit}</span>
              </dt>
              <dd class="ledger-label meta-type">{entry.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- The <img> is the rendered element until the WebGL layer reports
           ready; it stays the fallback for no-WebGL and reduced-motion. -->
      <div class="hero-portrait" data-hero="portrait" id="heroPortrait">
        <img
          src="/images/ikhsan-cutout.webp"
          alt="Ikhsan Kurniawan"
          width="1086"
          height="1233"
          fetchpriority="high"
          decoding="async"
        />
      </div>

    </div>
  </div>
</section>

<!-- Contact Modal -->
<div id="contact-modal" class="modal-overlay">
  <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <button id="close-modal" class="modal-close" aria-label="Close modal">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="modal-header">
      <h2 class="modal-title" id="contact-modal-title">Let's Connect</h2>
      <p class="modal-subtitle">Feel free to reach out through any of these channels</p>
    </div>

    <div class="contact-list">
      <a href="mailto:ikhsankurniawan.ikhwan@gmail.com" class="contact-item">
        <div class="contact-icon email-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="contact-info">
          <span class="contact-label">Email</span>
          <span class="contact-value">ikhsankurniawan.ikhwan@gmail.com</span>
        </div>
        <svg class="contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>

      <a href="https://wa.me/6281381799202" target="_blank" rel="noopener noreferrer" class="contact-item">
