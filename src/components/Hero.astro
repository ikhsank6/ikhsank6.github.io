---
const firstName = 'Ikhsan';
const lastName = 'Kurniawan';
---

<section id="home" class="hero">
  <div class="container">
    <div class="hero-wrapper" data-hero-exit>



      <!-- Eyebrow meta -->
      <div class="hero-eyebrow" data-hero="eyebrow">
        <span class="eyebrow-status">
          <span class="badge-dot"></span>
          Open to work
        </span>
        <span class="eyebrow-sep">·</span>
        <span class="eyebrow-location">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
          Jakarta, Indonesia
        </span>
      </div>

      <!-- Stacked display name -->
      <h1 class="hero-name display-type" aria-label={`${firstName} ${lastName}.`}>
        <span class="name-line" aria-hidden="true">
          {firstName.split('').map((letter) => <span class="name-letter">{letter}</span>)}
        </span>
        <span class="name-line" aria-hidden="true">
          {lastName.split('').map((letter) => <span class="name-letter">{letter}</span>)}<span class="name-letter name-period">.</span>
        </span>
      </h1>

      <!-- Description -->
      <div class="hero-bottom" data-hero="bottom">
        <p class="hero-description">
          <span class="desc-tag">Fullstack Developer</span> with 5+ years of experience building
          government-scale web platforms — backend APIs, frontend interfaces, and database
          architecture with Laravel, Node.js, Vue and Next.js.
        </p>
        <div class="hero-cta">
          <a href="#projects" class="btn-primary" data-magnetic>
            View My Work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
          <button id="open-contact-modal" class="btn-secondary" data-magnetic>
            Let's Connect
          </button>
        </div>
      </div>

      <!-- Stats chips -->
      <div class="hero-stats" data-hero="stats">
        <div class="stat" data-tilt>
          <span class="stat-value"><span data-count="5">5</span><span class="stat-plus">+</span></span>
          <span class="stat-label">Years of experience</span>
        </div>
        <div class="stat" data-tilt>
          <span class="stat-value"><span data-count="10">10</span><span class="stat-plus">+</span></span>
          <span class="stat-label">Projects delivered</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Contact Modal -->
<div id="contact-modal" class="modal-overlay">
  <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
    <button id="close-modal" class="modal-close" aria-label="Close modal">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <div class="modal-header">
      <h2 class="modal-title" id="contact-modal-title">Let's Connect</h2>
      <p class="modal-subtitle">Feel free to reach out through any of these channels</p>
    </div>

    <div class="contact-list">
      <a href="mailto:ikhsankurniawan.ikhwan@gmail.com" class="contact-item">
        <div class="contact-icon email-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="contact-info">
          <span class="contact-label">Email</span>
          <span class="contact-value">ikhsankurniawan.ikhwan@gmail.com</span>
        </div>
        <svg class="contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>

      <a href="https://wa.me/6281381799202" target="_blank" rel="noopener noreferrer" class="contact-item">
        <div class="contact-icon whatsapp-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </div>
        <div class="contact-info">
          <span class="contact-label">WhatsApp</span>
          <span class="contact-value">+62 813-8179-9202</span>
        </div>
        <svg class="contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>

      <a href="https://linkedin.com/in/ikhsank6" target="_blank" rel="noopener noreferrer" class="contact-item">
        <div class="contact-icon linkedin-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </div>
        <div class="contact-info">
          <span class="contact-label">LinkedIn</span>
          <span class="contact-value">linkedin.com/in/ikhsank6</span>
        </div>
        <svg class="contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 90px;
    padding-bottom: 90px;
    overflow: hidden;
  }

  .hero-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    gap: 36px;
  }



  /* Eyebrow */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.85rem;
    color: var(--c3-ink-soft);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .eyebrow-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--c3-green-deep);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .badge-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--c3-green-deep);
    opacity: 0.35;
    animation: pulse-ring 2.5s ease-in-out infinite;
  }

  @keyframes pulse-ring {
    0%, 100% { transform: scale(1); opacity: 0.35; }
    50% { transform: scale(2); opacity: 0; }
  }

  .eyebrow-sep { opacity: 0.5; }

  .eyebrow-location {
    display: flex;
    align-items: center;
    gap: 5px;
    opacity: 0.85;
  }

  /* Name */
  .hero-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(3.2rem, 10.5vw, 8.8rem);
    color: var(--c3-ink);
    z-index: 1;
  }

  .name-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    white-space: nowrap;
  }

  .name-letter {
    display: inline-block;
  }

  .name-period {
    color: var(--c3-green-text);
  }

  /* Bottom: description + CTAs */
  .hero-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: 720px;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .desc-tag {
    display: inline-flex;
    align-items: center;
    background: rgba(15, 243, 120, 0.16);
    color: var(--c3-green-text);
    border: 1px solid rgba(8, 194, 95, 0.35);
    border-radius: 100px;
    padding: 2px 12px;
    font-size: 0.9em;
    font-weight: 700;
    vertical-align: middle;
    margin-right: 4px;
  }

  /* CTAs — MetaMask pill language */
  .hero-cta {
    display: flex;
    gap: 14px;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--c3-green);
    color: var(--c3-dark);
    padding: 16px 32px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s var(--ease-out-expo);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(15, 243, 120, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--c3-surface);
    color: var(--c3-ink);
    padding: 16px 32px;
    border-radius: 12px;
    border: 1px solid var(--c3-line);
    font-weight: 600;
    font-size: 0.95rem;
    transition: border-color 0.3s var(--ease-out-expo), background 0.3s var(--ease-out-expo);
    cursor: pointer;
    font-family: var(--font-main);
  }

  .btn-secondary:hover {
    border-color: var(--c3-ink);
    background: var(--c3-surface-2);
  }

  /* Stats chips */
  .hero-stats {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: var(--c3-surface);
    border: 1px solid var(--c3-line);
    border-radius: 16px;
    padding: 18px 28px;
    min-width: 150px;
  }

  .stat-value {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--c3-ink);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .stat-plus {
    color: var(--c3-green-text);
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero-wrapper { gap: 28px; }

    .hero-eyebrow {
      flex-direction: column;
      gap: 8px;
    }

    .hero-cta {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .hero-stats { gap: 10px; }

    .stat {
      flex: 1 1 45%;
      min-width: 0;
      padding: 14px 12px;
    }
  }
</style>

<style is:global>
  /* Contact modal — light card (MetaMask style) */
  #contact-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(1, 30, 28, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 16px;
  }

  #contact-modal.active {
    opacity: 1;
    visibility: visible;
  }

  #contact-modal .modal-content {
    background: var(--mm-white);
    border-radius: clamp(20px, 4vw, 28px);
    padding: clamp(24px, 5vw, 40px);
    max-width: 500px;
    width: 100%;
    position: relative;
    transform: translateY(30px) scale(0.95);
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 25px 80px -12px rgba(0, 0, 0, 0.6);
  }

  #contact-modal.active .modal-content {
    transform: translateY(0) scale(1);
  }

  #contact-modal .modal-close {
    position: absolute;
    top: clamp(12px, 3vw, 20px);
    right: clamp(12px, 3vw, 20px);
    background: rgba(10, 10, 10, 0.05);
    border: 1px solid rgba(10, 10, 10, 0.12);
    color: rgba(10, 10, 10, 0.65);
    width: clamp(36px, 8vw, 44px);
    height: clamp(36px, 8vw, 44px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  #contact-modal .modal-close:hover {
    background: var(--mm-black);
    color: var(--mm-white);
    transform: rotate(90deg);
  }

  #contact-modal .modal-header {
    text-align: center;
    margin-bottom: clamp(24px, 6vw, 36px);
    padding: 0 20px;
  }

  #contact-modal .modal-title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 5vw, 1.8rem);
    color: var(--mm-black);
    margin-bottom: 8px;
  }

  #contact-modal .modal-subtitle {
    color: rgba(10, 10, 10, 0.55);
    font-size: clamp(0.85rem, 2.5vw, 1rem);
    line-height: 1.4;
  }

  #contact-modal .contact-list {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2vw, 14px);
  }

  #contact-modal .contact-item {
    display: flex;
    align-items: center;
    gap: clamp(12px, 3vw, 18px);
    padding: clamp(14px, 3vw, 20px);
    background: rgba(10, 10, 10, 0.03);
    border: 1.5px solid rgba(10, 10, 10, 0.1);
    border-radius: clamp(14px, 3vw, 18px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  #contact-modal .contact-item:hover {
    border-color: var(--mm-black);
    background: rgba(10, 10, 10, 0.05);
    transform: translateX(4px);
  }

  #contact-modal .contact-icon {
    width: clamp(40px, 10vw, 52px);
    height: clamp(40px, 10vw, 52px);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #contact-modal .email-icon { background: linear-gradient(135deg, #ea4335 0%, #fbbc05 100%); color: white; }
  #contact-modal .whatsapp-icon { background: linear-gradient(135deg, #25d366 0%, #128c7e 100%); color: white; }
  #contact-modal .linkedin-icon { background: linear-gradient(135deg, #0077b5 0%, #00a0dc 100%); color: white; }

  #contact-modal .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  #contact-modal .contact-label {
    font-size: clamp(0.7rem, 2vw, 0.75rem);
    color: rgba(10, 10, 10, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  #contact-modal .contact-value {
    font-size: clamp(0.85rem, 2.8vw, 1rem);
    color: var(--mm-black);
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.3s ease;
  }

  #contact-modal .contact-item:hover .contact-value {
    color: var(--mm-orange);
  }

  #contact-modal .contact-arrow {
    color: rgba(10, 10, 10, 0.3);
    transform: translateX(0);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  #contact-modal .contact-item:hover .contact-arrow {
    transform: translateX(4px);
    color: var(--mm-orange);
  }

  @media (max-width: 400px) {
    #contact-modal .modal-content { padding: 24px 16px; }
    #contact-modal .contact-item { padding: 12px; gap: 12px; }
    #contact-modal .contact-icon { width: 38px; height: 38px; }
    #contact-modal .contact-value { font-size: 0.8rem; }
  }
</style>

<script>
  import { trapFocus } from '../scripts/focus-trap';

  const openBtn = document.getElementById('open-contact-modal');
  const closeBtn = document.getElementById('close-modal');
  const modal = document.getElementById('contact-modal');
  const modalContent = modal?.querySelector<HTMLElement>('.modal-content');

  let releaseFocus: (() => void) | null = null;

  function openModal() {
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      if (modalContent) releaseFocus = trapFocus(modalContent);
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      releaseFocus?.();
      releaseFocus = null;
    }
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // The contact CTA section reuses this modal.
  document.querySelectorAll('[data-open-contact]').forEach((el) => {
    el.addEventListener('click', openModal);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('active')) {
      closeModal();
    }
  });
</script>
