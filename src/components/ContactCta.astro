---
const lineOne = "Let's build";
const lineTwo = 'something real.';
---

<section id="contact" class="cta-section">
  <div class="cta-inner">
    <h2 class="cta-title display-type" aria-label={`${lineOne} ${lineTwo}`}>
      <span class="cta-line" aria-hidden="true">
        {lineOne.split('').map((letter) => (
          <span class="cta-letter">{letter === ' ' ? ' ' : letter}</span>
        ))}
      </span>
      <span class="cta-line" aria-hidden="true">
        {lineTwo.split('').map((letter) => (
          <span class="cta-letter">{letter === ' ' ? ' ' : letter}</span>
        ))}
      </span>
    </h2>
    <p class="cta-sub">
      Have a project, a role, or an idea worth shipping? I'm one message away.
    </p>
    <div class="cta-actions">
      <a href="mailto:ikhsankurniawan.ikhwan@gmail.com" class="cta-mail" data-magnetic>
        Email Me
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M7 17L17 7M17 7H7M17 7V17"/>
        </svg>
      </a>
      <button type="button" class="cta-connect" data-open-contact data-magnetic>
        All Channels
      </button>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: var(--c3-green);
    padding-top: 140px;
    padding-bottom: 150px;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  .cta-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.4rem, 8vw, 6.5rem);
    color: var(--mm-black);
  }

  .cta-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    white-space: nowrap;
  }

  .cta-letter {
    display: inline-block;
  }

  :global(html.js) .cta-letter {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .cta-letter {
      opacity: 1;
    }
  }

  .cta-sub {
    font-size: 1.05rem;
    font-weight: 600;
    color: rgba(10, 10, 10, 0.75);
    max-width: 480px;
  }

  .cta-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--mm-black);
    color: var(--mm-white);
    padding: 18px 36px;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: box-shadow 0.3s var(--ease-out-expo);
  }

  .cta-mail:hover {
    box-shadow: 0 14px 36px rgba(10, 10, 10, 0.35);
  }

  .cta-connect {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: var(--mm-black);
    padding: 18px 36px;
    border-radius: 100px;
    border: 1.5px solid rgba(10, 10, 10, 0.5);
    font-weight: 700;
    font-size: 0.95rem;
    font-family: var(--font-main);
    cursor: pointer;
    transition: background 0.3s var(--ease-out-expo);
  }

  .cta-connect:hover {
    background: rgba(10, 10, 10, 0.08);
  }
</style>
