---
import { getTechIconUrl } from '../utils/techIcons';

interface Skill {
  name: string;
  /** Official brand hex, matching the SimpleIcons glyph. */
  brand: string;
}

interface StackGroup {
  title: string;
  items: Skill[];
}

/* Grouped rather than one tile per technology: with 23 separate cards the
   category label repeated six times over and the section read as a logo dump.
   Four panels carry the same information and say something the tiles could
   not — which side of the stack each tool belongs to. */
const groups: StackGroup[] = [
  {
    title: 'Backend',
    items: [
      { name: 'Laravel', brand: '#FF2D20' },
      { name: 'Codeigniter', brand: '#EF4223' },
      { name: 'Livewire', brand: '#4E56A6' },
      { name: 'Node.js', brand: '#5FA04E' },
      { name: 'NestJS', brand: '#E0234E' },
      { name: 'Express', brand: '#000000' },
    ],
  },
  {
    title: 'Frontend',
    items: [
      { name: 'TypeScript', brand: '#3178C6' },
      { name: 'JavaScript', brand: '#F7DF1E' },
      { name: 'Vue.js', brand: '#4FC08D' },
      { name: 'React', brand: '#61DAFB' },
      { name: 'Next.js', brand: '#000000' },
      { name: 'Tailwind CSS', brand: '#06B6D4' },
      { name: 'Bootstrap CSS', brand: '#7952B3' },
    ],
  },
  {
    title: 'Data',
    items: [
      { name: 'PostgreSQL', brand: '#4169E1' },
      { name: 'MySQL', brand: '#4479A1' },
      { name: 'MongoDB', brand: '#47A248' },
      { name: 'Redis', brand: '#FF4438' },
      { name: 'Prisma', brand: '#2D3748' },
    ],
  },
  {
    title: 'Platform',
    items: [
      { name: 'Docker', brand: '#2496ED' },
      { name: 'Kubernetes', brand: '#326CE5' },
      { name: 'RabbitMQ', brand: '#FF6600' },
      { name: 'Moodle', brand: '#F98012' },
      { name: 'Leaflet', brand: '#199900' },
    ],
  },
];

/* Brand hexes are picked for logos on white, not for text — JavaScript's
   #F7DF1E sits at 1.4:1 and React's #61DAFB at 1.6:1. Washes and hairlines can
   use the raw colour, but a label cannot, so derive a readable variant at
   build time instead of hand-picking 23 second colours. */
const channel = (value: number): number => {
  const c = value / 255;
  return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
};

const toRgb = (hex: string): [number, number, number] => [
  parseInt(hex.slice(1, 3), 16),
  parseInt(hex.slice(3, 5), 16),
  parseInt(hex.slice(5, 7), 16),
];

const contrastOnWhite = ([r, g, b]: [number, number, number]): number => {
  const luminance = 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
  return 1.05 / (luminance + 0.05);
};

/** Darken toward black until the colour clears AA (4.5:1) on white. */
const readableInk = (hex: string): string => {
  const [r, g, b] = toRgb(hex);
  let k = 1;
  while (k > 0.05 && contrastOnWhite([r * k, g * k, b * k]) < 4.5) k -= 0.04;
  return `rgb(${Math.round(r * k)}, ${Math.round(g * k)}, ${Math.round(b * k)})`;
};

const rgba = (hex: string, alpha: number): string => {
  const [r, g, b] = toRgb(hex);
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
};

const itemVars = (hex: string): string =>
  [
    `--brand: ${hex}`,
    `--brand-ink: ${readableInk(hex)}`,
    `--brand-wash: ${rgba(hex, 0.09)}`,
    `--brand-line: ${rgba(hex, 0.28)}`,
  ].join('; ');

const total = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<section id="skills" class="skills-section">
  <div class="section-header" data-animate>
    <div class="section-tag">
      <span class="hashtag">#</span>
      <span>Technical Stack</span>
      <span class="stack-total">{total} Technologies</span>
    </div>
    <h2 class="section-title">My <span class="accent-text">Skills</span></h2>
    <p class="section-description">The technologies and tools I use to bring ideas to life.</p>
  </div>

  <div class="stack-grid" data-animate>
    {groups.map((group) => (
      <article class="stack-group">
        <header class="group-head">
          <h3 class="group-title">{group.title}</h3>
          <span class="group-count meta-type">{String(group.items.length).padStart(2, '0')}</span>
        </header>

        <ul class="group-items">
          {group.items.map((skill) => (
            <li class="stack-item" style={itemVars(skill.brand)}>
              <span class="item-icon">
                <img src={getTechIconUrl(skill.name) || ''} alt="" loading="lazy" width="22" height="22" />
              </span>
              <span class="item-name">{skill.name}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .skills-section {
    padding-bottom: 80px;
  }

  .stack-total {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-left: 10px;
    margin-left: 4px;
    border-left: 1px solid var(--c3-line);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  /* The panel is the only box in the section — items inside are content, not
     cards, so the eye counts four things instead of twenty-three. */
  .stack-group {
    background: var(--c3-surface);
    border: 1px solid var(--c3-line);
    border-radius: 20px;
    padding: 26px 28px 28px;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--c3-line);
  }

  .group-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .group-count {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .group-items {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px 7px 7px;
    border-radius: 100px;
    background: var(--c3-white);
    border: 1px solid var(--c3-line);
    transition:
      background 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo),
      transform 0.3s var(--ease-out-expo);
  }

  .stack-item:hover {
    background: var(--brand-wash);
    border-color: var(--brand-line);
    transform: translateY(-2px);
  }

  .item-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .item-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .item-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.3s var(--ease-out-expo);
  }

  /* Darkened brand variant, never the raw hex — see readableInk(). */
  .stack-item:hover .item-name {
    color: var(--brand-ink);
  }

  @media (max-width: 968px) {
    .stack-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stack-group {
      padding: 22px 20px 24px;
      border-radius: 16px;
    }
  }

  @media (max-width: 480px) {
    .item-name { font-size: 0.8rem; }
    .stack-item { padding: 6px 12px 6px 6px; gap: 7px; }
    .item-icon { width: 22px; height: 22px; }
  }
</style>
