---
---

<div class="animated-bg">
  <!-- Gradient Orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  
  <!-- Grid Pattern -->
  <div class="grid-pattern"></div>
  
  <!-- Floating Particles -->
  <div class="particles" id="particles"></div>
  
  <!-- Noise Texture -->
  <div class="noise"></div>
</div>

<style>
  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(135deg, #050505 0%, #0a0a0a 50%, #050505 100%);
  }

  /* Floating Gradient Orbs */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
    animation: float 20s ease-in-out infinite;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 102, 255, 0.4) 0%, transparent 70%);
    top: -200px;
    right: -100px;
    animation-delay: 0s;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(212, 255, 0, 0.2) 0%, transparent 70%);
    bottom: -150px;
    left: -100px;
    animation-delay: -7s;
    animation-duration: 25s;
  }

  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(138, 43, 226, 0.3) 0%, transparent 70%);
    top: 50%;
    left: 30%;
    animation-delay: -14s;
    animation-duration: 30s;
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(50px, -30px) scale(1.05);
    }
    50% {
      transform: translate(-30px, 50px) scale(0.95);
    }
    75% {
      transform: translate(-50px, -20px) scale(1.02);
    }
  }

  /* Grid Pattern */
  .grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  /* Particles Container */
  .particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Noise Texture Overlay */
  .noise {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  :global(.particle) {
    position: absolute;
    background: var(--accent-blue);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
  }

  :global(.particle-line) {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-blue), transparent);
    pointer-events: none;
    opacity: 0;
  }
</style>

<script>
  const container = document.getElementById('particles');
  
  function createParticle() {
    if (!container) return;
    
    const particle = document.createElement('div');
    particle.className = 'particle';
    
    const size = Math.random() * 4 + 2;
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    const duration = Math.random() * 3000 + 2000;
    
    particle.style.width = `${size}px`;
    particle.style.height = `${size}px`;
    particle.style.left = `${x}px`;
    particle.style.top = `${y}px`;
    particle.style.boxShadow = `0 0 ${size * 2}px var(--accent-blue)`;
    
    container.appendChild(particle);
    
    particle.animate([
      { opacity: 0, transform: 'translateY(0) scale(0)' },
      { opacity: 0.6, transform: 'translateY(-20px) scale(1)', offset: 0.3 },
      { opacity: 0, transform: 'translateY(-60px) scale(0.5)' }
    ], {
      duration: duration,
      easing: 'ease-out'
    }).onfinish = () => particle.remove();
  }

  function createLine() {
    if (!container) return;
    
    const line = document.createElement('div');
    line.className = 'particle-line';
    
    const width = Math.random() * 150 + 50;
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    const duration = Math.random() * 2000 + 1500;
    
    line.style.width = `${width}px`;
    line.style.left = `${x}px`;
    line.style.top = `${y}px`;
    
    container.appendChild(line);
    
    line.animate([
      { opacity: 0, transform: 'translateX(-100px) scaleX(0)' },
      { opacity: 0.4, transform: 'translateX(0) scaleX(1)', offset: 0.5 },
      { opacity: 0, transform: 'translateX(100px) scaleX(0)' }
    ], {
      duration: duration,
      easing: 'ease-in-out'
    }).onfinish = () => line.remove();
  }

  // Create particles periodically
  setInterval(createParticle, 300);
  setInterval(createLine, 800);
  
  // Initial burst
  for (let i = 0; i < 10; i++) {
    setTimeout(createParticle, i * 100);
  }
</script>
