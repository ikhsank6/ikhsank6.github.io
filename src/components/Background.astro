---
---

<div class="animated-bg" aria-hidden="true">
  <!-- Gradient Orbs — .orb-wrap = parallax layer, .orb = GSAP float -->
  <div class="orb-wrap orb-wrap-1"><div class="orb orb-1"></div></div>
  <div class="orb-wrap orb-wrap-2"><div class="orb orb-2"></div></div>
  <div class="orb-wrap orb-wrap-3"><div class="orb orb-3"></div></div>

  <!-- Grid Pattern -->
  <div class="grid-pattern"></div>

  <!-- Floating Particles -->
  <div class="particles" id="particles"></div>
</div>

<style>
  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(135deg, #080808 0%, #101010 50%, #080808 100%);
  }

  .orb-wrap {
    position: absolute;
    will-change: transform;
    contain: layout style;
  }

  .orb {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.4;
    will-change: transform;
  }

  .orb-wrap-1 {
    width: 600px;
    height: 600px;
    top: -150px;
    right: -80px;
  }

  .orb-1 {
    background: radial-gradient(circle, rgba(0, 102, 255, 0.55) 0%, rgba(0, 102, 255, 0.15) 45%, transparent 70%);
  }

  .orb-wrap-2 {
    width: 500px;
    height: 500px;
    bottom: -100px;
    left: -80px;
  }

  .orb-2 {
    background: radial-gradient(circle, rgba(212, 255, 0, 0.45) 0%, rgba(212, 255, 0, 0.12) 45%, transparent 70%);
  }

  .orb-wrap-3 {
    width: 420px;
    height: 420px;
    top: 50%;
    left: 30%;
  }

  .orb-3 {
    background: radial-gradient(circle, rgba(138, 43, 226, 0.4) 0%, rgba(138, 43, 226, 0.12) 45%, transparent 70%);
  }

  .grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 100%);
  }

  .particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .particles { display: none; }
  }

  :global(.particle) {
    position: absolute;
    background: var(--accent-blue);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
  }

  :global(.particle-line) {
    position: absolute;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-blue), transparent);
    pointer-events: none;
    opacity: 0;
  }
</style>

<script>
  const container = document.getElementById('particles');
  const MAX_PARTICLES = 15;
  
  function createParticle() {
    if (!container || container.childElementCount >= MAX_PARTICLES) return;
    
    const particle = document.createElement('div');
    particle.className = 'particle';
    
    const size = Math.random() * 4 + 2;
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    const duration = Math.random() * 3000 + 2000;
    
    particle.style.cssText = `width:${size}px;height:${size}px;left:${x}px;top:${y}px;box-shadow:0 0 ${size * 2}px var(--accent-blue)`;
    
    container.appendChild(particle);
    
    particle.animate([
      { opacity: 0, transform: 'translateY(0) scale(0)' },
      { opacity: 0.8, transform: 'translateY(-20px) scale(1)', offset: 0.3 },
      { opacity: 0, transform: 'translateY(-60px) scale(0.5)' }
    ], {
      duration: duration,
      easing: 'ease-out'
    }).onfinish = () => particle.remove();
  }

  function createLine() {
    if (!container || container.childElementCount >= MAX_PARTICLES) return;
    
    const line = document.createElement('div');
    line.className = 'particle-line';
    
    const width = Math.random() * 150 + 50;
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    const duration = Math.random() * 2000 + 1500;
    
    line.style.cssText = `width:${width}px;left:${x}px;top:${y}px`;
    
    container.appendChild(line);
    
    line.animate([
      { opacity: 0, transform: 'translateX(-100px) scaleX(0)' },
      { opacity: 0.6, transform: 'translateX(0) scaleX(1)', offset: 0.5 },
      { opacity: 0, transform: 'translateX(100px) scaleX(0)' }
    ], {
      duration: duration,
      easing: 'ease-in-out'
    }).onfinish = () => line.remove();
  }

  // Reduced frequency particles + visibility check
  let particleInterval: ReturnType<typeof setInterval>;
  let lineInterval: ReturnType<typeof setInterval>;

  function startParticles() {
    particleInterval = setInterval(createParticle, 3000);
    lineInterval = setInterval(createLine, 5000);
  }

  function stopParticles() {
    clearInterval(particleInterval);
    clearInterval(lineInterval);
  }

  // Only create particles when page is visible
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopParticles();
    } else {
      startParticles();
    }
  });

  startParticles();
  
  for (let i = 0; i < 2; i++) {
    setTimeout(createParticle, i * 500);
  }
</script>
