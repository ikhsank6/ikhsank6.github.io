---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-marquee" aria-hidden="true">
    <div class="footer-marquee-track" data-footer-marquee>
      {[0, 1].map(() => (
        <span class="footer-wordmark">
          Ikhsan Kurniawan<span class="footer-dot">.</span>&nbsp;
        </span>
      ))}
    </div>
  </div>

  <div class="footer-bottom">
    <p class="copyright">© {currentYear} Ikhsan Kurniawan. Assisted by AI.</p>
    <p class="built-with">
      Built with <span class="tech">Astro</span> + <span class="tech">React</span> + <span class="tech">GSAP</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--mm-black);
    padding: 70px var(--gutter) 40px;
    overflow: hidden;
  }

  .footer-marquee {
    overflow: hidden;
    white-space: nowrap;
    margin-inline: calc(-1 * var(--gutter));
    margin-bottom: 56px;
  }

  .footer-marquee-track {
    display: inline-flex;
    will-change: transform;
  }

  .footer-wordmark {
    font-size: clamp(4rem, 12vw, 11rem);
    color: var(--mm-white);
    line-height: 1;
    padding-right: 0.4em;
  }

  .footer-dot {
    color: var(--mm-orange);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 30px;
  }

  .copyright, .built-with {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tech {
    color: var(--mm-orange);
    font-weight: 600;
  }

  @media (max-width: 968px) {
    .footer {
      padding-bottom: 120px; /* clearance for the floating bottom navbar */
    }

    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
