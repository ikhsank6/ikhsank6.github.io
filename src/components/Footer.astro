---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-main">
        <a href="#home" class="footer-logo">
          Ikhsan<span class="accent">.</span>
        </a>
        <p class="footer-tagline">
          Building the future, one line of code at a time.
        </p>
      </div>
      
      <div class="footer-links">
        <div class="footer-group">
          <h4>Navigation</h4>
          <a href="#home">Home</a>
          <a href="#projects">Work</a>
          <a href="#skills">Stack</a>
          <a href="#education">About</a>
        </div>
        
        <div class="footer-group">
          <h4>Connect</h4>
          <a href="https://github.com/ikhsank6" target="_blank">GitHub</a>
          <a href="https://linkedin.com/in/ikhsank6" target="_blank">LinkedIn</a>
          <a href="mailto:ikhsank6@gmail.com">Email</a>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} Ikhsan Kurniawan. All rights reserved.
      </p>
      <p class="built-with">
        Built with <span class="tech">Astro</span> + <span class="tech">React</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 60px 0 40px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-main {
    max-width: 300px;
  }

  .footer-logo {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    display: inline-block;
    margin-bottom: 12px;
  }

  .footer-logo .accent {
    color: var(--accent-lime);
  }

  .footer-tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    gap: 80px;
  }

  .footer-group h4 {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }

  .footer-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-group a {
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: var(--transition-fast);
  }

  .footer-group a:hover {
    color: var(--accent-lime);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    border-top: 1px solid var(--border-subtle);
  }

  .copyright {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .built-with {
    font-size: 0.85rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tech {
    color: var(--accent-lime);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 40px;
    }

    .footer-links {
      gap: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
