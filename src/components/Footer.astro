---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-bottom">
    <p class="copyright">© {currentYear} Ikhsan Kurniawan. All rights reserved.</p>
    <p class="built-with">
      Built with <span class="tech">Astro</span> + <span class="tech">React</span> + <span class="tech">GSAP</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--mm-black);
    padding: 24px var(--gutter);
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright, .built-with {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tech {
    color: var(--mm-orange);
    font-weight: 600;
  }

  @media (max-width: 968px) {
    .footer {
      padding-top: 24px;
      padding-bottom: 84px; /* clearance for the floating bottom navbar */
    }

    .footer-bottom {
      flex-direction: column;
      gap: 10px;
      text-align: center;
    }
  }
</style>
