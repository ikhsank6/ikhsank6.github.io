---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-bottom">
      <div class="footer-info">
        <p class="copyright">© {currentYear} Ikhsan Kurniawan. All rights reserved.</p>
        <p class="built-with">
          Built with <span class="tech">Astro</span> + <span class="tech">React</span>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 30px 0;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-main {
    max-width: 300px;
  }

  .footer-logo {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    display: inline-block;
    margin-bottom: 12px;
  }

  .footer-logo .accent {
    color: var(--accent-lime);
  }

  .footer-tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-lime);
  }

  .footer-links a svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 30px;
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .copyright, .built-with {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tech {
    color: var(--accent-lime);
    font-weight: 600;
  }

  @media (max-width: 968px) {
    .footer {
      padding-bottom: 120px; /* Extra padding for floating navbar */
    }

    .footer-content {
      flex-direction: column;
      gap: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }

    .footer-info {
      flex-direction: column;
      gap: 8px;
    }

    .footer-links {
      gap: 24px;
      justify-content: center;
    }
  }
</style>
