---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-bottom">
      <div class="footer-info">
        <p class="copyright">© {currentYear} Ikhsan Kurniawan. All rights reserved.</p>
        <p class="built-with">
          Built with <span class="tech">Astro</span> + <span class="tech">React</span>
        </p>
      </div>
      
      <div class="footer-links">
        <a href="https://linkedin.com/in/ikhsank6" target="_blank">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          LinkedIn
        </a>
        <a href="mailto:ikhsankurniawan.ikhwan@gmail.com">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>
      </div>

      
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 30px 0;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-main {
    max-width: 300px;
  }

  .footer-logo {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    display: inline-block;
    margin-bottom: 12px;
  }

  .footer-logo .accent {
    color: var(--accent-lime);
  }

  .footer-tagline {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .footer-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--accent-lime);
  }

  .footer-links a svg {
    flex-shrink: 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 30px;
  }

  .footer-info {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .copyright, .built-with {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tech {
    color: var(--accent-lime);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 40px;
    }

    .footer-links {
      gap: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
