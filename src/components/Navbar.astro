---
const navItems = [
  {
    name: 'Home',
    href: '#home',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    name: 'Stack',
    href: '#skills',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`
  },
  {
    name: 'Work',
    href: '#projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  {
    name: 'About',
    href: '#about',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
  {
    name: 'Contact',
    href: '#contact',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`
  },
];
---

<nav class="floating-nav" id="floatingNav" aria-label="Section navigation">
  {navItems.map(item => (
    <a href={item.href} class="floating-item" aria-label={item.name}>
      <div class="circle-icon" set:html={item.icon}></div>
      <span class="floating-label">{item.name}</span>
    </a>
  ))}
</nav>

<style>
  .floating-nav {
    position: fixed;
    left: 32px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .floating-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  /* Solid dark chips — legible over every section color (MetaMask pattern) */
  .circle-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.85);
    transition: var(--transition-fast);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .floating-item:hover .circle-icon {
    border-color: var(--mm-orange);
    color: var(--mm-orange);
    transform: scale(1.08);
  }

  .floating-item.active .circle-icon {
    background: var(--mm-orange);
    border-color: var(--mm-orange);
    color: var(--mm-white);
  }

  .floating-label {
    position: absolute;
    left: 62px;
    background: var(--mm-black);
    color: var(--mm-white);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-10px);
    transition: var(--transition-fast);
    pointer-events: none;
    white-space: nowrap;
  }

  .floating-item:hover .floating-label,
  .floating-item:focus-visible .floating-label {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 968px) {
    .floating-nav {
      left: 50%;
      top: auto;
      bottom: 20px;
      transform: translateX(-50%);
      flex-direction: row;
      gap: 10px;
      background: rgba(10, 10, 10, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 10px 16px;
      border-radius: 100px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .circle-icon {
      width: 44px;
      height: 44px;
      border: none;
      background: transparent;
      box-shadow: none;
    }

    .floating-item.active .circle-icon {
      background: var(--mm-orange);
    }

    .floating-label {
      display: none;
    }
  }
</style>

<script>
  const navLinks = document.querySelectorAll('.floating-item');

  const hrefToId: Record<string, string> = {
    '#home': 'home',
    '#skills': 'skills',
    '#projects': 'projects',
    '#about': 'about',
    '#contact': 'contact'
  };

  function setActiveNav() {
    const sections = document.querySelectorAll('section[id]');
    const scrollPosition = window.scrollY + window.innerHeight / 3;
    let currentSection = 'home';

    sections.forEach(section => {
      const el = section as HTMLElement;
      const sectionTop = el.offsetTop;
      const sectionBottom = sectionTop + el.offsetHeight;
      if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
        currentSection = el.getAttribute('id') || 'home';
      }
    });

    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      link.classList.toggle('active', !!href && hrefToId[href] === currentSection);
    });
  }

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        setActiveNav();
        ticking = false;
      });
      ticking = true;
    }
  });

  setTimeout(setActiveNav, 500);
  window.addEventListener('hashchange', () => setTimeout(setActiveNav, 100));
</script>
