---
const navItems = [
  { 
    name: 'Work', 
    href: '#projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  { 
    name: 'Stack', 
    href: '#skills',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`
  },
  { 
    name: 'About', 
    href: '#education',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
];
---

<nav class="navbar" id="topNavbar">
  <div class="container">
    <div class="nav-wrapper">
      <a href="#home" class="nav-logo">
        Ikhsan<span class="accent">.</span>
      </a>
      
      <div class="nav-center">
        {navItems.map(item => (
          <a href={item.href} class="nav-link">{item.name}</a>
        ))}
      </div>

      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Floating Side Menu (Scrolled State) -->
<div class="floating-nav" id="floatingNav">
  {navItems.map(item => (
    <a href={item.href} class="floating-item" title={item.name}>
      <div class="circle-icon" set:html={item.icon}></div>
      <span class="floating-label">{item.name}</span>
    </a>
  ))}
</div>

<div class="mobile-menu" id="mobileMenu">
  {navItems.map(item => (
    <a href={item.href} class="mobile-link">{item.name}</a>
  ))}
  <a href="mailto:ikhsank6@gmail.com" class="mobile-link cta">Contact</a>
</div>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 24px 0;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
    transition: transform 0.4s var(--ease-out-expo), opacity 0.4s var(--ease-out-expo);
  }

  .navbar.hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .nav-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-logo {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .nav-logo .accent {
    color: var(--accent-lime);
  }

  .nav-center {
    display: flex;
    gap: 48px;
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 32px;
    border-radius: 100px;
    border: 1px solid var(--border-subtle);
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: var(--transition-smooth);
  }

  .nav-link:hover {
    color: var(--accent-lime);
  }

  /* Floating Nav Styles */
  .floating-nav {
    position: fixed;
    left: 40px;
    top: 50%;
    transform: translateY(-50%) translateX(-120px);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transition: transform 0.6s var(--ease-out-expo), opacity 0.4s var(--ease-out-expo);
    pointer-events: none;
  }

  .floating-nav.visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  .floating-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    group;
  }

  .circle-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    color: var(--text-secondary);
    transition: var(--transition-smooth);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .floating-item:hover .circle-icon {
    background: rgba(212, 255, 0, 0.1);
    border-color: var(--accent-lime);
    color: var(--accent-lime);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(212, 255, 0, 0.2);
  }

  .floating-label {
    position: absolute;
    left: 64px;
    background: var(--bg-card);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-10px);
    transition: var(--transition-fast);
    pointer-events: none;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .floating-item:hover .floating-label {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--text-primary);
    transition: var(--transition-fast);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 80px;
    left: 20px;
    right: 20px;
    background: var(--bg-container);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: 32px;
    z-index: 1000;
    flex-direction: column;
    gap: 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-align: center;
  }

  .mobile-link:hover {
    color: var(--accent-lime);
  }

  @media (max-width: 968px) {
    .nav-center {
      display: none;
    }
    
    .floating-nav {
      display: none; /* Hide floating nav on small tablets/mobile */
    }
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 20px 0;
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const topNavbar = document.getElementById('topNavbar');
  const floatingNav = document.getElementById('floatingNav');

  // Mobile menu toggle
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('active');
  });

  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
    });
  });

  // Scroll detection
  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 150) {
      topNavbar?.classList.add('hidden');
      floatingNav?.classList.add('visible');
    } else {
      topNavbar?.classList.remove('hidden');
      floatingNav?.classList.remove('visible');
    }
  });
</script>
