---
const navItems = [
  { 
    name: 'Home', 
    href: '#home',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  { 
    name: 'Stack', 
    href: '#skills',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>`
  },
  { 
    name: 'Work', 
    href: '#projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  { 
    name: 'About', 
    href: '#about',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`
  },
];
---

<!-- Floating Side Menu (Always Visible) -->
<div class="floating-nav" id="floatingNav">
  <div class="nav-notice" id="navNotice">
    <span>Click here to navigate</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
  </div>
  
  {navItems.map(item => (
    <a href={item.href} class="floating-item" title={item.name}>
      <div class="circle-icon" set:html={item.icon}></div>
      <span class="floating-label">{item.name}</span>
    </a>
  ))}
</div>



<style>
  /* Floating Nav - Always Visible */
  .floating-nav {
    position: fixed;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-notice {
    position: absolute;
    left: 64px;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    color: var(--accent-lime);
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    animation: pulse-notice 2s infinite;
    cursor: pointer;
  }

  @keyframes pulse-notice {
    0%, 100% { opacity: 1; transform: translateX(0); }
    50% { opacity: 0.7; transform: translateX(4px); }
  }

  .nav-notice.hidden {
    display: none;
  }

  .floating-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .circle-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    color: var(--text-secondary);
    transition: var(--transition-smooth);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .floating-item:hover .circle-icon {
    background: rgba(212, 255, 0, 0.1);
    border-color: var(--accent-lime);
    color: var(--accent-lime);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(212, 255, 0, 0.2);
  }

  .floating-label {
    position: absolute;
    left: 64px;
    background: var(--bg-card);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-10px);
    transition: var(--transition-fast);
    pointer-events: none;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .floating-item:hover .floating-label {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu-btn {
    display: none;
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 1001;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    cursor: pointer;
    padding: 12px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: var(--transition-fast);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 80px;
    left: 20px;
    right: 20px;
    background: var(--bg-container);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: 32px;
    z-index: 1000;
    flex-direction: column;
    gap: 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-align: center;
  }

  .mobile-link:hover {
    color: var(--accent-lime);
  }

  @media (max-width: 968px) {
    .floating-nav {
      left: 50%;
      top: auto;
      bottom: 24px;
      transform: translateX(-50%);
      flex-direction: row;
      gap: 12px;
      background: rgba(10, 10, 10, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 12px 20px;
      border-radius: 100px;
      border: 1px solid var(--border-subtle);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .nav-notice {
      display: none;
    }
    
    .circle-icon {
      width: 44px;
      height: 44px;
    }

    .floating-label {
      display: none;
    }
  }
</style>

<script>


  // Hide notice on hover or click of any nav item
  document.querySelectorAll('.floating-item').forEach(item => {
    item.addEventListener('mouseenter', () => {
      navNotice?.classList.add('hidden');
      localStorage.setItem('navNoticeSeen', 'true');
    });
    item.addEventListener('click', () => {
      navNotice?.classList.add('hidden');
      localStorage.setItem('navNoticeSeen', 'true');
    });
  });

  // Check if notice was already seen - only hide if localStorage says so
  document.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('navNoticeSeen') === 'true') {
      navNotice?.classList.add('hidden');
    }
  });

  // Also hide notice on click
  navNotice?.addEventListener('click', () => {
    navNotice?.classList.add('hidden');
    localStorage.setItem('navNoticeSeen', 'true');
  });

  // Auto-hide after 10 seconds
  setTimeout(() => {
    navNotice?.classList.add('hidden');
  }, 10000);
</script>
