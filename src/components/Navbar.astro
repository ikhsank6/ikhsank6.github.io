---

<!-- Floating Side Menu (Always Visible) -->
<div class="floating-nav" id="floatingNav">
  <div class="nav-notice" id="navNotice">
    <span>Click here to navigate</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
  </div>
  
  {navItems.map(item => (
    <a href={item.href} class="floating-item" title={item.name}>
      <div class="circle-icon" set:html={item.icon}></div>
      <span class="floating-label">{item.name}</span>
    </a>
  ))}
</div>



<style>
  /* Floating Nav - Always Visible */
  .floating-nav {
    position: fixed;
    left: 40px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .nav-notice {
    position: absolute;
    /* Desktop: Right side of navbar */
    top: 0;
    left: 70px;
    transform: none;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    color: var(--accent-lime);
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
    animation: pulse-notice 2s infinite;
    cursor: default;
    pointer-events: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .nav-notice svg {
    transform: rotate(180deg); /* Arrow pointing left to menu */
    order: -1; /* Move arrow to the left of the text */
  }

  @keyframes pulse-notice {
    0%, 100% { opacity: 1; transform: translateX(0); }
    50% { opacity: 0.8; transform: translateX(5px); }
  }

  .nav-notice.hidden {
    display: none !important;
  }

  .floating-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .circle-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    color: var(--text-secondary);
    transition: var(--transition-smooth);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .floating-item:hover .circle-icon {
    background: rgba(212, 255, 0, 0.1);
    border-color: var(--accent-lime);
    color: var(--accent-lime);
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(212, 255, 0, 0.2);
  }

  /* Active state for current section */
  .floating-item.active .circle-icon {
    background: rgba(212, 255, 0, 0.15);
    border-color: var(--accent-lime);
    color: var(--accent-lime);
    box-shadow: 0 0 25px rgba(212, 255, 0, 0.3);
  }

  .floating-label {
    position: absolute;
    left: 64px;
    background: var(--bg-card);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0;
    transform: translateX(-10px);
    transition: var(--transition-fast);
    pointer-events: none;
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .floating-item:hover .floating-label {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu-btn {
    display: none;
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 1001;
    flex-direction: column;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    cursor: pointer;
    padding: 12px;
  }

  .mobile-menu-btn span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: var(--transition-fast);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 80px;
    left: 20px;
    right: 20px;
    background: var(--bg-container);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    padding: 32px;
    z-index: 1000;
    flex-direction: column;
    gap: 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .mobile-menu.active {
    display: flex;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-align: center;
  }

  .mobile-link:hover {
    color: var(--accent-lime);
  }

  @media (max-width: 968px) {
    .floating-nav {
      left: 50%;
      top: auto;
      bottom: 24px;
      transform: translateX(-50%);
      flex-direction: row;
      gap: 12px;
      background: rgba(10, 10, 10, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 12px 20px;
      border-radius: 100px;
      border: 1px solid var(--border-subtle);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .nav-notice {
      display: flex;
      flex-direction: row;
      top: 50%;
      left: auto;
      right: -130px; /* Position to the right side */
      transform: translateY(-50%);
      animation: pulse-notice-mobile 2s infinite;
    }

    .nav-notice svg {
      transform: rotate(180deg); /* Point left to menu */
      order: -1;
    }
    
    .nav-notice span {
       display: inline-block;
    }

    /* Adjust animation for mobile context */
    @keyframes pulse-notice-mobile {
      0%, 100% { opacity: 1; transform: translateY(-50%) translateX(0); }
      50% { opacity: 0.7; transform: translateY(-50%) translateX(3px); }
    }

    .circle-icon {
      width: 44px;
      height: 44px;
    }

    .floating-label {
      display: none;
    }
  }
</style>

<script>
  const navNotice = document.getElementById('navNotice');

  // Check if notice was already seen
  if (localStorage.getItem('navNoticeSeen') === 'true') {
    navNotice?.classList.add('hidden');
  }

  // Hide notice when any nav item is clicked
  document.querySelectorAll('.floating-item').forEach(item => {
    item.addEventListener('click', () => {
      navNotice?.classList.add('hidden');
      localStorage.setItem('navNoticeSeen', 'true');
    });
  });

  // Auto-hide after 5 seconds and remember
  setTimeout(() => {
    navNotice?.classList.add('hidden');
    localStorage.setItem('navNoticeSeen', 'true');
  }, 5000);

  // Active section detection
  const navLinks = document.querySelectorAll('.floating-item');

  // Map nav hrefs to section IDs
  const hrefToId: Record<string, string> = {
    '#home': 'home',
    '#skills': 'skills',
    '#projects': 'projects',
    '#about': 'about'
  };

  function setActiveNav() {
    // Query sections dynamically (important for client:only components)
    const sections = document.querySelectorAll('section[id]');
    const scrollPosition = window.scrollY + window.innerHeight / 3;
    let currentSection = 'home';
    
    sections.forEach(section => {
      const sectionTop = section.offsetTop;
      const sectionBottom = sectionTop + section.offsetHeight;
      
      if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
        currentSection = section.getAttribute('id') || 'home';
      }
    });

    // Clear all active states first
    navLinks.forEach(link => {
      link.classList.remove('active');
    });

    // Set active based on current section
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      if (href && hrefToId[href] === currentSection) {
        link.classList.add('active');
      }
    });
  }

  // Run on scroll with throttle for performance
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        setActiveNav();
        ticking = false;
      });
      ticking = true;
    }
  });

  // Run on load with delay to wait for React components
  setTimeout(setActiveNav, 500);

  // Also update on hash change (when clicking nav links)
  window.addEventListener('hashchange', () => {
    setTimeout(setActiveNav, 100);
  });
</script>
