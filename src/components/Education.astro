---
const experience = [
  {
    role: 'Full Stack Developer',
    company: 'PT. Mitreka Solusi Indonesia',
    period: '2022 - Present',
    description: [
      'Design, develop, and maintain scalable web applications, APIs, and system integrations',
      'Implement best practices in coding standards, system design and optimized database performance.',
      'Support deployment processes and production troubleshooting.'
    ],
  },
  {
    role: 'Full Stack Developer',
    company: 'PT Maxxima Innovative Engineering',
    period: '2018 - 2022',
    description: [
      'Design, develop, and maintain scalable web applications, APIs, and system integrations',
      'Implement best practices in coding standards, system design and optimized database performance.',
      'Support deployment processes and production troubleshooting.'
    ],
  }
];

const education = [
  {
    degree: 'Bachelor of Computer Science',
    school: 'IPB University',
    period: '2015 - 2018',
    description: [],
  },
  {
    degree: 'D3 Information System',
    school: 'Telkom University',
    period: '2012 - 2015',
    description: [],
  }
];

const certificates = [
  {
    title: 'Senior Programmer',
    issuer: 'BNSP - No.Reg. TIK.317.02993 2023',
    period: '2023',
    image: '/images/certificate_bnsp.webp',
  }
];
---

<section id="about">
  <div class="container">
    <div class="section-header">
      <div class="section-tag animate-on-scroll">
        <span class="hashtag">#</span>
        <span>About</span>
      </div>
      <h2 class="section-title animate-on-scroll delay-1">
        Experience, Education & Certifications
      </h2>
      <p class="section-description animate-on-scroll delay-2">
        My professional journey and academic background
      </p>
    </div>
    
    <div class="about-grid">
      <div class="about-column">
        <h3 class="column-title animate-on-scroll">
          <span class="title-icon">💼</span>
          Experience
        </h3>
        <div class="timeline">
          {experience.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.role}</h4>
                <p class="timeline-company">{item.company}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="about-column">
        <h3 class="column-title animate-on-scroll">
          <span class="title-icon">🎓</span>
          Education
        </h3>
        <div class="timeline">
          {education.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot edu"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.degree}</h4>
                <p class="timeline-company">{item.school}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) && item.description.length > 0 ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <h3 class="column-title animate-on-scroll" style="margin-top: 64px;">
          <span class="title-icon">📜</span>
          Certifications
        </h3>
        <div class="timeline">
          {certificates.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot cert"></div>
              <div class="timeline-body">
                <span class="timeline-period cert">{item.period}</span>
                <h4 class="timeline-title">{item.title}</h4>
                <p class="timeline-company">{item.issuer}</p>
                <button class="show-cert-btn" data-image={item.image} data-title={item.title}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Show Certificate
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  </div>
</section>

<style>
  #about {
    padding: 120px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .column-title {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 48px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .title-icon {
    font-size: 1.6rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: 24px;
    position: relative;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    background: var(--accent-lime);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 8px;
    box-shadow: 0 0 20px rgba(212, 255, 0, 0.4);
    z-index: 2;
  }

  .timeline-dot.edu {
    background: var(--accent-blue);
    box-shadow: 0 0 20px rgba(0, 102, 255, 0.4);
  }

  .timeline-dot.cert {
    background: var(--accent-gold); /* Gold color for certificates */
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
  }

  .timeline-body {
    flex: 1;
    padding-bottom: 48px;
    border-left: 2px solid var(--border-subtle);
    padding-left: 32px;
    margin-left: -32px; /* Pull back to align with dot center */
  }

  /* Adjust line position to center of dot */
  .timeline-body::before {
    display: none;
  }

  /* Corrected line alignment */
  .timeline-item {
    padding-left: 6px; /* center dot on line */
  }

  .timeline-item:last-child .timeline-body {
    border-left-color: transparent;
    padding-bottom: 0;
  }

  .timeline-period {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-lime);
    background: rgba(212, 255, 0, 0.1);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 16px;
    border: 1px solid rgba(212, 255, 0, 0.2);
  }

  .timeline-item:has(.timeline-dot.edu) .timeline-period {
    color: var(--accent-blue);
    background: rgba(0, 102, 255, 0.1);
    border-color: rgba(0, 102, 255, 0.2);
  }

  .timeline-period.cert {
    color: var(--accent-gold);
    background: rgba(255, 215, 0, 0.1);
    border-color: rgba(255, 215, 0, 0.2);
  }

  .timeline-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .timeline-company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .timeline-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .description-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .description-list li {
    position: relative;
    padding-left: 20px;
  }

  .description-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-lime);
    font-weight: bold;
  }

  .timeline-item:has(.timeline-dot.edu) .description-list li::before {
    color: var(--accent-blue);
  }

  /* Certificate Button Style */
  .show-cert-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 10px 20px;
    background: rgba(255, 215, 0, 0.05);
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 100px;
    color: var(--accent-gold);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
  }

  .show-cert-btn:hover {
    background: rgba(255, 215, 0, 0.1);
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 215, 0, 0.1);
  }

  .btn-icon {
    font-size: 1.1rem;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>
