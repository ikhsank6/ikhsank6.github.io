---
const experience = [
  {
    role: 'Full Stack Developer',
    company: 'PT. Mitreka Solusi Indonesia',
    period: '2022 - Present',
    description: [
  'Design, develop, and maintain scalable web applications and RESTful APIs based on business and system requirements.',
  'Collaborate with cross-functional teams (QA, BA/SA, and DevOps) to deliver features and ensure successful User Acceptance Testing (UAT).',
  'Optimize application performance through code optimization, database query tuning, and system performance improvements.',
  'Troubleshoot, debug, and perform root cause analysis to resolve production issues efficiently.',
  'Implement clean architecture, coding standards, and best practices to ensure system maintainability, scalability, security, and reliability.'
],
  },
  {
    role: 'Full Stack Developer',
    company: 'PT Maxxima Innovative Engineering',
    period: '2018 - 2022',
    description: [
  'Develop, maintain, and enhance web-based applications based on business and system requirements.',
  'Implement backend logic, database integration, and efficient database schema design.',
  'Identify, analyze, and resolve application issues to ensure system stability and reliability.',
  'Collaborate with cross-functional teams using agile development practices to deliver features on schedule.',
  'Maintain existing systems and continuously improve features based on user feedback and business requirements.',
  'Support deployment processes and configure development and production environments.'
],
  }
];

const education = [
  {
    degree: 'Bachelor of Computer Science',
    school: 'IPB University',
    period: '2015 - 2018',
    description: [],
  },
  {
    degree: 'D3 Information System',
    school: 'Telkom University',
    period: '2012 - 2015',
    description: [],
  }
];

const certificates = [
  {
    title: 'Senior Programmer',
    issuer: 'BNSP - No.Reg. TIK.317.02993 2023',
    period: '2023',
    image: '/images/certificate_bnsp.webp',
  }
];
---

<section id="about">
  <div class="container">
    <div class="section-header">
      <div class="section-tag" data-animate>
        <span class="hashtag">#</span>
        <span>About</span>
      </div>
      <h2 class="section-title" data-animate>
        Experience, Education & Certifications
      </h2>
      <p class="section-description" data-animate>
        My professional journey and academic background
      </p>
    </div>
    
    <div class="about-grid">
      <div class="about-column">
        <h3 class="column-title" data-animate>
          Experience
          <span class="column-count meta-type">{String(experience.length).padStart(2, '0')}</span>
        </h3>
        <div class="timeline">
          <div class="timeline-spine" aria-hidden="true"></div>
          {experience.map((item, index) => (
            <div class="timeline-item" data-animate>
              <div class="timeline-dot"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.role}</h4>
                <p class="timeline-company">{item.company}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="about-column">
        <h3 class="column-title" data-animate>
          Education
          <span class="column-count meta-type">{String(education.length).padStart(2, '0')}</span>
        </h3>
        <div class="timeline">
          <div class="timeline-spine" aria-hidden="true"></div>
          {education.map((item, index) => (
            <div class="timeline-item" data-animate>
              <div class="timeline-dot edu"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.degree}</h4>
                <p class="timeline-company">{item.school}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) && item.description.length > 0 ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <h3 class="column-title" data-animate style="margin-top: 64px;">
          Certifications
          <span class="column-count meta-type">{String(certificates.length).padStart(2, '0')}</span>
        </h3>
        <div class="timeline">
          <div class="timeline-spine" aria-hidden="true"></div>
          {certificates.map((item, index) => (
            <div class="timeline-item" data-animate>
              <div class="timeline-dot cert"></div>
              <div class="timeline-body">
                <span class="timeline-period cert">{item.period}</span>
                <h4 class="timeline-title">{item.title}</h4>
                <p class="timeline-company">{item.issuer}</p>
                <button class="show-cert-btn" data-image={item.image} data-title={item.title}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Show Certificate
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .column-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 48px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* How many entries the column holds — real information, and it keeps the
     rule from ending on empty space. */
  .column-count {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* Indigo spine drawn over the static light line via GSAP scaleY scrub */
  .timeline-spine {
    position: absolute;
    top: 10px;
    bottom: 40px;
    left: 12px;
    width: 2px;
    background: var(--c3-green-deep);
    transform-origin: top center;
    transform: scaleY(0);
    pointer-events: none;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-spine { display: none; }
  }

  .timeline-item {
    display: flex;
    gap: 24px;
    position: relative;
    z-index: 2;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    background: var(--c3-green-deep);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 8px;
    z-index: 2;
  }

  .timeline-dot.edu {
    background: var(--c3-ink);
  }

  .timeline-dot.cert {
    background: var(--c3-purple);
  }

  .timeline-body {
    flex: 1;
    padding-bottom: 48px;
    border-left: 2px solid var(--border-subtle);
    padding-left: 32px;
    margin-left: -32px; /* Pull back to align with dot center */
  }

  /* Adjust line position to center of dot */
  .timeline-body::before {
    display: none;
  }

  /* Corrected line alignment */
  .timeline-item {
    padding-left: 6px; /* center dot on line */
  }

  .timeline-item:last-child .timeline-body {
    border-left-color: transparent;
    padding-bottom: 0;
  }

  .timeline-period {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--c3-green-deep);
    background: rgba(15, 243, 120, 0.14);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 16px;
    border: 1px solid rgba(8, 194, 95, 0.25);
  }

  .timeline-item:has(.timeline-dot.edu) .timeline-period {
    color: var(--c3-ink);
    background: rgba(20, 20, 20, 0.06);
    border-color: rgba(20, 20, 20, 0.14);
  }

  .timeline-period.cert {
    color: var(--c3-purple);
    background: rgba(124, 58, 237, 0.08);
    border-color: rgba(124, 58, 237, 0.25);
  }

  .timeline-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .timeline-company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .timeline-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .description-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .description-list li {
    position: relative;
    padding-left: 20px;
  }

  .description-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--c3-green-deep);
    font-weight: bold;
  }

  .timeline-item:has(.timeline-dot.edu) .description-list li::before {
    color: var(--c3-ink);
  }

  /* Certificate Button Style */
  .show-cert-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 12px 24px;
    background: var(--mm-black);
    border: none;
    border-radius: 100px;
    color: var(--mm-white);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-main);
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
  }

  .show-cert-btn:hover {
    background: var(--c3-green);
    color: var(--c3-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(15, 243, 120, 0.35);
  }

  .btn-icon {
    font-size: 1.1rem;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>
