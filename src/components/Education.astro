---
const experience = [
  {
    role: 'Full Stack Developer',
    company: 'PT. Mitreka Solusi Indonesia',
    period: '2022 - Present',
    description: [
      'Design, develop, and maintain scalable web applications, APIs, and system integrations',
      'Implement best practices in coding standards, system design and optimized database performance.',
      'Support deployment processes and production troubleshooting.'
    ],
  },
  {
    role: 'Full Stack Developer',
    company: 'PT Maxxima Innovative Engineering',
    period: '2018 - 2022',
    description: [
      'Design, develop, and maintain scalable web applications, APIs, and system integrations',
      'Implement best practices in coding standards, system design and optimized database performance.',
      'Support deployment processes and production troubleshooting.'
    ],
  }
];

const education = [
  {
    degree: 'Bachelor of Computer Science',
    school: 'IPB University',
    period: '2015 - 2018',
    description: [],
  },
  {
    degree: 'D3 Information System',
    school: 'Telkom University',
    period: '2012 - 2015',
    description: [],
  }
];

const certificates = [
  {
    title: 'Senior Programmer',
    issuer: 'BNSP - No.Reg. TIK.317.02993 2023',
    period: '2023',
    image: '/images/certificate_bnsp.png',
  }
];
---

<section id="about">
  <div class="container">
    <div class="section-header">
      <div class="section-tag animate-on-scroll">
        <span class="hashtag">#</span>
        <span>About</span>
      </div>
      <h2 class="section-title animate-on-scroll delay-1">
        Experience, Education & Certifications
      </h2>
      <p class="section-description animate-on-scroll delay-2">
        My professional journey and academic background
      </p>
    </div>
    
    <div class="about-grid">
      <div class="about-column">
        <h3 class="column-title animate-on-scroll">
          <span class="title-icon">💼</span>
          Experience
        </h3>
        <div class="timeline">
          {experience.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.role}</h4>
                <p class="timeline-company">{item.company}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      
      <div class="about-column">
        <h3 class="column-title animate-on-scroll">
          <span class="title-icon">🎓</span>
          Education
        </h3>
        <div class="timeline">
          {education.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot edu"></div>
              <div class="timeline-body">
                <span class="timeline-period">{item.period}</span>
                <h4 class="timeline-title">{item.degree}</h4>
                <p class="timeline-company">{item.school}</p>
                <div class="timeline-description">
                  {Array.isArray(item.description) && item.description.length > 0 ? (
                    <ul class="description-list">
                      {item.description.map(point => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  ) : (
                    item.description
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <h3 class="column-title animate-on-scroll" style="margin-top: 64px;">
          <span class="title-icon">📜</span>
          Certifications
        </h3>
        <div class="timeline">
          {certificates.map((item, index) => (
            <div class="timeline-item animate-on-scroll" style={`transition-delay: ${0.1 * index}s`}>
              <div class="timeline-dot cert"></div>
              <div class="timeline-body">
                <span class="timeline-period cert">{item.period}</span>
                <h4 class="timeline-title">{item.title}</h4>
                <p class="timeline-company">{item.issuer}</p>
                <button class="show-cert-btn" data-image={item.image} data-title={item.title}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  Show Certificate
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Certificate Modal -->
  <div id="certModal" class="lightbox-overlay">
    <button class="lightbox-close" id="closeModal">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="lightbox-title-overlay">
      <h4 id="modalTitle"></h4>
    </div>

    <div class="lightbox-image-wrapper">
      <div class="lightbox-image-container" id="modalImageContainer">
        <img id="modalImage" src="" alt="Certificate" draggable="false" />
      </div>
      
      <div class="lightbox-controls-container">
        <!-- Zoom Controls -->
        <div class="lightbox-zoom-controls">
          <button id="zoomOut" title="Zoom Out">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
          <span id="zoomLevel">100%</span>
          <button id="zoomIn" title="Zoom In">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
          </button>
          <button id="resetZoom" title="Reset">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #education {
    padding: 120px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 80px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .column-title {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 48px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .title-icon {
    font-size: 1.6rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: 24px;
    position: relative;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    background: var(--accent-lime);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 8px;
    box-shadow: 0 0 20px rgba(212, 255, 0, 0.4);
    z-index: 2;
  }

  .timeline-dot.edu {
    background: var(--accent-blue);
    box-shadow: 0 0 20px rgba(0, 102, 255, 0.4);
  }

  .timeline-dot.cert {
    background: var(--accent-gold); /* Gold color for certificates */
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
  }

  .timeline-body {
    flex: 1;
    padding-bottom: 48px;
    border-left: 2px solid var(--border-subtle);
    padding-left: 32px;
    margin-left: -32px; /* Pull back to align with dot center */
  }

  /* Adjust line position to center of dot */
  .timeline-body::before {
    display: none;
  }

  /* Corrected line alignment */
  .timeline-item {
    padding-left: 6px; /* center dot on line */
  }

  .timeline-item:last-child .timeline-body {
    border-left-color: transparent;
    padding-bottom: 0;
  }

  .timeline-period {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-lime);
    background: rgba(212, 255, 0, 0.1);
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 16px;
    border: 1px solid rgba(212, 255, 0, 0.2);
  }

  .timeline-item:has(.timeline-dot.edu) .timeline-period {
    color: var(--accent-blue);
    background: rgba(0, 102, 255, 0.1);
    border-color: rgba(0, 102, 255, 0.2);
  }

  .timeline-period.cert {
    color: var(--accent-gold);
    background: rgba(255, 215, 0, 0.1);
    border-color: rgba(255, 215, 0, 0.2);
  }

  .timeline-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    line-height: 1.2;
  }

  .timeline-company {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .timeline-description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .description-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .description-list li {
    position: relative;
    padding-left: 20px;
  }

  .description-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-lime);
    font-weight: bold;
  }

  .timeline-item:has(.timeline-dot.edu) .description-list li::before {
    color: var(--accent-blue);
  }

  /* Certificate Button Style */
  .show-cert-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 10px 20px;
    background: rgba(255, 215, 0, 0.05);
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 100px;
    color: var(--accent-gold);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s var(--ease-out-expo);
  }

  .show-cert-btn:hover {
    background: rgba(255, 215, 0, 0.1);
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 215, 0, 0.1);
  }

  .btn-icon {
    font-size: 1.1rem;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
</style>

<script>
  const setupModal = () => {
    const modal = document.getElementById('certModal');
    const modalImg = document.getElementById('modalImage') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle');
    const closeBtn = document.getElementById('closeModal');
    const showBtns = document.querySelectorAll('.show-cert-btn');
    const imageContainer = document.getElementById('modalImageContainer');

    // Zoom Controls
    const zoomInBtn = document.getElementById('zoomIn');
    const zoomOutBtn = document.getElementById('zoomOut');
    const resetZoomBtn = document.getElementById('resetZoom');
    const zoomLevelText = document.getElementById('zoomLevel');

    if (!modal || !modalImg || !modalTitle || !closeBtn || !imageContainer) return;

    let zoom = 1;
    let isDragging = false;
    let startX = 0, startY = 0;
    let translateX = 0, translateY = 0;

    const updateTransform = () => {
      modalImg.style.transform = `scale(${zoom}) translate(${translateX / zoom}px, ${translateY / zoom}px)`;
      if (zoomLevelText) zoomLevelText.textContent = `${Math.round(zoom * 100)}%`;
      
      if (zoom > 1) {
        imageContainer.classList.add('zoomed');
      } else {
        imageContainer.classList.remove('zoomed');
        translateX = 0;
        translateY = 0;
        modalImg.style.transform = `scale(${zoom}) translate(0, 0)`;
      }
    };

    const openModal = (imgSrc: string, title: string) => {
      modalImg.src = imgSrc;
      modalTitle.textContent = title;
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
      resetZoom();
    };

    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      setTimeout(() => {
        modalImg.src = '';
        resetZoom();
      }, 400);
    };

    const resetZoom = () => {
      zoom = 1;
      translateX = 0;
      translateY = 0;
      updateTransform();
    };

    const handleZoom = (delta: number) => {
      const newZoom = Math.max(1, Math.min(zoom + delta, 4));
      zoom = newZoom;
      updateTransform();
    };

    // Event Listeners
    showBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const img = btn.getAttribute('data-image');
        const title = btn.getAttribute('data-title');
        if (img && title) openModal(img, title);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    zoomInBtn?.addEventListener('click', () => handleZoom(0.5));
    zoomOutBtn?.addEventListener('click', () => handleZoom(-0.5));
    resetZoomBtn?.addEventListener('click', resetZoom);

    // Mouse Panning
    imageContainer.addEventListener('mousedown', (e) => {
      if (zoom > 1) {
        isDragging = true;
        imageContainer.classList.add('dragging');
        startX = e.clientX - translateX;
        startY = e.clientY - translateY;
      }
    });

    window.addEventListener('mousemove', (e) => {
      if (isDragging) {
        translateX = e.clientX - startX;
        translateY = e.clientY - startY;
        updateTransform();
      }
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
      imageContainer.classList.remove('dragging');
    });

    // Touch Panning
    imageContainer.addEventListener('touchstart', (e) => {
      if (zoom > 1 && e.touches.length === 1) {
        isDragging = true;
        startX = e.touches[0].clientX - translateX;
        startY = e.touches[0].clientY - translateY;
      }
    }, { passive: true });

    imageContainer.addEventListener('touchmove', (e) => {
      if (isDragging && e.touches.length === 1) {
        translateX = e.touches[0].clientX - startX;
        translateY = e.touches[0].clientY - startY;
        updateTransform();
      }
    }, { passive: false });

    imageContainer.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  };

  // Run on initial load
  setupModal();

  // Re-run after any DOM changes (for Astro view transitions or hydration)
  document.addEventListener('astro:page-load', setupModal);
</script>
