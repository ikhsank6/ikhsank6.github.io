---
/**
 * Brand preloader — plays on every load, including refreshes. Skipped
 * entirely for reduced-motion users (html.skip-intro, set inline in Layout
 * before first paint). Sequencing lives in scripts/animations.ts.
 */
const firstName = 'IKHSAN';
const lastName = 'KURNIAWAN';
---

<div class="preloader" id="preloader" aria-hidden="true">
  <div class="preloader-panel preloader-panel-top"></div>
  <div class="preloader-panel preloader-panel-bottom"></div>
  <div class="preloader-inner">
    <p class="preloader-label">Portfolio — Fullstack Developer</p>
    <p class="preloader-wordmark display-type">
      <span class="preloader-line">
        {firstName.split('').map((letter) => <span class="preloader-letter">{letter}</span>)}
      </span>
      <span class="preloader-line">
        {lastName.split('').map((letter) => <span class="preloader-letter">{letter}</span>)}
      </span>
    </p>
    <p class="preloader-counter"><span id="preloaderCount">0</span>%</p>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 20000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .preloader-panel {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50.5%; /* slight overlap — avoids a seam line between panels */
    background: var(--c3-dark);
    will-change: transform;
  }

  .preloader-panel-top { top: 0; }
  .preloader-panel-bottom { bottom: 0; }

  .preloader-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    padding: 0 24px;
  }

  .preloader-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .preloader-wordmark {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 9vw, 7rem);
    color: var(--c3-white);
    line-height: 0.98;
  }

  .preloader-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em; /* keep descender-less glyphs from clipping */
  }

  .preloader-letter {
    display: inline-block;
    will-change: transform;
  }

  .preloader-counter {
    font-size: 1rem;
    font-weight: 700;
    color: var(--c3-green);
    font-variant-numeric: tabular-nums;
  }

  /* Hidden before paint for returning visitors / reduced motion / no-JS */
  :global(html.skip-intro) .preloader,
  :global(html:not(.js)) .preloader {
    display: none;
  }
</style>
